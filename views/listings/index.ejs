<% layout('layouts/boilerplate') %>

<h3>All Listings</h3>

<form method="GET" action="/listings" class="mb-4">
  <div class="row g-3 align-items-center">
    <div class="col-auto">
      <input type="text" name="location" class="form-control" placeholder="Search by location" value="<%= typeof location !== 'undefined' ? location : '' %>">
    </div>
    <div class="col-auto">
      <input type="number" name="minPrice" class="form-control" placeholder="Min Price" min="0" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>">
    </div>
    <div class="col-auto">
      <input type="number" name="maxPrice" class="form-control" placeholder="Max Price" min="0" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>">
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary">Search</button>
    </div>
  </div>
</form>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% if (allListings && allListings.length > 0) { %>
    <% for(let listing of allListings) { %>
      <div class="card col listing-card">
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <img 
            src="<%= listing.image?.url || '/default-image.jpg' %>" 
            class="card-img-top"
            alt="listing_image"
            style="height:20rem"
          />
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b>  <br />
            &#8377; <%= Number(listing.price || 0).toLocaleString("en-IN") %> /night
            </p>
          </div>
        </a>
      </div>
    <% } %>
  <% } else { %>
    <p>No listings available.</p>
  <% } %>
</div>
